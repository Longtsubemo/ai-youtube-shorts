# Copy to `.env` in this directory before running docker compose.
# `.env` is gitignored; never commit the generated password.

# Throwaway password for the isolated local Postgres. Generate a fresh one, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# This DB is on a private compose bridge network and is not published, so the
# password is a hygiene measure, not a real secret. It still is not committed.
POSTGRES_PASSWORD=CHANGE_ME_generate_a_random_value

# Point the Firecrawl search tier at the experiment's own SearXNG container
# instead of letting it fall back to DuckDuckGo scraping. From inside a
# container, the host is reachable as host.docker.internal.
# Requires the SearXNG stack to be running:
#   docker compose -f experiments/retrieval/searxng/docker-compose.yml up -d
SEARXNG_ENDPOINT=http://host.docker.internal:8080

# Reduced from the upstream server-sized defaults; see docker-compose.yml.
NUM_WORKERS_PER_QUEUE=1
CRAWL_CONCURRENT_REQUESTS=2
MAX_CONCURRENT_JOBS=1
BROWSER_POOL_SIZE=1

# Host port for the API. 3002 is the upstream default.
PORT=3002