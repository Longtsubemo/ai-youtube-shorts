      },
      {
        "line_id": "ln_01",
        "text": "Why octopuses have three hearts? Let's take a closer look at the answer.",
        "claim_refs": [],
        "purpose": "context",
        "estimated_duration_seconds": 5.2
      },
      {
        "line_id": "ln_02",
        "text": "Octopuses have three hearts: two branchial hearts that push blood through the gills and a systemic heart that powers the body.",
        "claim_refs": [
          "cl_b4ca50a10d"
        ],
        "purpose": "fact",
        "estimated_duration_seconds": 8.4
      },
      {
        "line_id": "ln_03",
        "text": "While octopuses swim, the two branchial hearts stop beating because the body diverts oxygen to the systemic heart.",
        "claim_refs": [
          "cl_f6089873c8"
        ],
        "purpose": "explanation",
        "estimated_duration_seconds": 7.2
      },
      {
        "line_id": "ln_04",
        "text": "Octopus blood uses copper-based hemocyanin, which means their blood appears blue.",
        "claim_refs": [
          "cl_97628e259b"
        ],
        "purpose": "explanation",
        "estimated_duration_seconds": 4.4
      },
      {
        "line_id": "ln_05",
        "text": "Here's one more detail worth knowing.",
