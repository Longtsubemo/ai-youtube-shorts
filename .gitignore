# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Cache / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment / secrets
.env
.env.*
!.env.example

# OpenCode session artifacts (local-only; per-session, not shared)
# All three are genuinely ignored. docs/PROJECT_PROGRESS.md was previously
# tracked and was untracked with `git rm --cached`, which keeps the local file
# and drops it from future commits. AGENTS.md and opencode_report.md were never
# tracked, so listing them here is sufficient on its own.
AGENTS.md
opencode_report.md
docs/PROJECT_PROGRESS.md

# Generated media and large artifacts
data/videos/*
!data/videos/.gitkeep
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3
*.m4a

# Per-run generated artifacts (data/<run_id>/...) - keep mock + static dirs tracked
data/*/
!data/mock/
!data/research/
!data/scripts/
!data/production/
!data/videos/

# Notebooks (Colab scratch)
.ipynb_checkpoints/
*.ipynb

# IDE / editor
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db