# Pipeline configuration.
# Copy this file to .env (ignored by git) and fill in values once a
# stage that needs them is implemented.
#
# Warning: never commit a real .env, and never commit real API keys.

# Gemini provider (real candidate/research execution).
# Required only for runs that opt in with --provider gemini (default is mock).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Firecrawl retrieval provider (Stage-2 real web retrieval).
# Optional: the search endpoint works on a keyless free tier (rate-limited per
# IP). Set FIRECRAWL_API_KEY for higher rate limits. Used only with
# `--provider gemini --retriever firecrawl`.
# FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=

# Example — voice/audio and publishing keys land here later.